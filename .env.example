# Variables d'environnement ALEK Artisan
# Copiez ce fichier vers .env.local et renseignez les valeurs réelles.
# Ne commitez jamais .env.local ni de clé réelle.

# --- Site public (utilisé par sitemap, robots, liens de signature) ---
# Sans cette variable, "https://app.alek.best" est utilisé.
NEXT_PUBLIC_SITE_URL=

# --- Mentions légales et support (affichés sur les pages légales) ---
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=

# --- Supabase (client navigateur, exposé publiquement) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (serveur uniquement, ne jamais exposer au navigateur) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- IA (Groq) ---
GROQ_API_KEY=
# Modèle vision utilisé pour l'analyse de photos et de reçus
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- PayPal ---
# "sandbox" ou "live"
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PRO_PLAN_ID=
PAYPAL_BUSINESS_PLAN_ID=
# Identifiant du webhook de l’application PayPal (sandbox pour les tests)
PAYPAL_WEBHOOK_ID=

# --- Protection du formulaire d'inscription (clé publique hCaptcha) ---
# Si activée, configurer aussi le secret hCaptcha dans Supabase Auth.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# --- Paiement par carte intégré (Stripe) ---
# Utilisez exclusivement les clés et prix de TEST pour les vérifications locales.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
